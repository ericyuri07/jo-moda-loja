# Copie para .env.production NO SERVIDOR e preencha. Nunca suba o .env.production para o Git.
#   cp .env.production.example .env.production && nano .env.production

# Endereço do site. Sem domínio: ":80". Com domínio: "jomodas.com.br" (HTTPS automático).
SITE_ADDRESS=:80

APP_NAME="Jo Modas"
APP_ENV=production
# Gere com: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# Mesmo endereço do site, com http:// ou https://. Ex.: http://123.45.67.89 ou https://jomodas.com.br
APP_URL=http://IP-DO-SERVIDOR

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Banco (o container mysql é criado com estes dados na primeira vez)
DB_DATABASE=jomodas_db
DB_USERNAME=jomodas_user
# Use senhas longas e diferentes. Gere com: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# O projeto não tem tabelas de sessão/cache/fila; arquivo e sync bastam para a API.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

BCRYPT_ROUNDS=12

# Código secreto exigido para cadastrar administradores (POST /api/auth/register-admin).
# Gere com: openssl rand -hex 16
ADMIN_REGISTER_CODE=
