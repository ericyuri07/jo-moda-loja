{
	frankenphp
}

# SITE_ADDRESS vem do .env:
#   - sem domínio ainda: ":80"            -> http://IP-DO-SERVIDOR
#   - com domínio:       "jomodas.com.br" -> HTTPS automático (Let's Encrypt)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API Laravel
	@api path /api /api/* /up
	handle @api {
		root * /app/public
		php_server
	}

	# Site Flutter Web (build/web copiado para deploy/front)
	handle {
		root * /srv/front

		# Os arquivos do Flutter mantêm o mesmo nome a cada build (main.dart.js...),
		# então o navegador guarda a cópia mas confere sempre se ela mudou (ETag).
		header Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
