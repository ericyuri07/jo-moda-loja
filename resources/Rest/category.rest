# php artisan serve -> 8000 | Docker -> 8021
@baseUrl = http://127.0.0.1:8000/api

# Fluxo: rode o "Login como admin" (0), depois "Criar categoria" (2).
# O id da categoria criada é reaproveitado nas requisições 3, 4 e 5.
@token = {{loginAdmin.response.body.token}}
@categoryId = {{createCategory.response.body.id}}

### 0. Login como admin (necessário para criar/editar/excluir)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "admin@jomodas.com",
    "password": "admin123"
}

### 1. Listar categorias (público)
GET {{baseUrl}}/categories
Accept: application/json

### 2. Criar categoria (admin) — slug é gerado a partir do nome se omitido
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "name": "Bonés"
}

### 3. Buscar categoria por ID (público)
GET {{baseUrl}}/categories/{{categoryId}}
Accept: application/json

### 4. Atualizar categoria (admin)
PUT {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "name": "Bonés e Chapéus"
}

### 5. Deletar categoria (admin)
DELETE {{baseUrl}}/categories/{{categoryId}}
Accept: application/json
Authorization: Bearer {{token}}
